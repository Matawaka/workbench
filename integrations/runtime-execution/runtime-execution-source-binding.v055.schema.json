{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:runtime-execution-source-binding:v0.55",
  "title": "Matawaka provenance-bound runtime execution source v0.55",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Schema", "BindingId", "SourceRepository", "SourceFrontier",
    "SourceArtifactSha256", "RequestEnvelopeSha256", "SourceAuthorityEffect",
    "ProcessEffectCeiling", "OneShot", "MaxCalls", "TtlSeconds",
    "FreshHumanConfirmationRequired", "NetworkAuthorized",
    "ModelRequestAuthorized", "GameAccessAuthorized", "DisplayAuthorized"
  ],
  "properties": {
    "Schema": { "const": "matawaka.runtime-execution-source-binding/v0.55" },
    "BindingId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{7,127}$" },
    "SourceRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "SourceFrontier": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "SourceArtifactSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "RequestEnvelopeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "SourceAuthorityEffect": { "const": "NONE_BY_SOURCE_RECORD" },
    "ProcessEffectCeiling": { "const": "EXACT_RUNTIME_ONLY" },
    "OneShot": { "const": true },
    "MaxCalls": { "const": 1 },
    "TtlSeconds": { "type": "integer", "minimum": 30, "maximum": 1800 },
    "FreshHumanConfirmationRequired": { "const": true },
    "NetworkAuthorized": { "const": false },
    "ModelRequestAuthorized": { "const": false },
    "GameAccessAuthorized": { "const": false },
    "DisplayAuthorized": { "const": false }
  }
}
