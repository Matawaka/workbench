{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:runtime-tree-manifest:v0.53",
  "title": "Matawaka Runtime Tree Manifest v0.53",
  "type": "object",
  "additionalProperties": false,
  "required": ["Schema", "Version", "ManifestId", "State", "RuntimeRoot", "Files", "Note"],
  "properties": {
    "Schema": { "const": "matawaka.runtime-tree-manifest/v0.53" },
    "Version": { "const": "0.53" },
    "ManifestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "State": { "const": "MATERIALIZED_VERIFIED" },
    "RuntimeRoot": { "type": "string", "minLength": 3 },
    "Files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["RelativePath", "Bytes", "Sha256", "Role"],
        "properties": {
          "RelativePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "Bytes": { "type": "integer", "minimum": 0 },
          "Sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "Role": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "Note": { "type": "string", "maxLength": 4096 }
  }
}
