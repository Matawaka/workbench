{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:runtime-materialization-request:v0.54",
  "title": "Matawaka Workbench bounded runtime-tree materialization request v0.54",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Schema",
    "RequestId",
    "AcquisitionReceiptPath",
    "AcquisitionReceiptSha256",
    "ArtifactIds",
    "DestinationRoot",
    "MaxFiles",
    "MaxExpandedBytes",
    "TtlSeconds"
  ],
  "properties": {
    "Schema": {
      "const": "matawaka.runtime-materialization-request/v0.54"
    },
    "RequestId": {
      "type": "string",
      "pattern": "^matreq-[A-Za-z0-9_.-]+$",
      "maxLength": 128
    },
    "AcquisitionReceiptPath": {
      "type": "string",
      "minLength": 1
    },
    "AcquisitionReceiptSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "ArtifactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "DestinationRoot": {
      "type": "string",
      "minLength": 1
    },
    "MaxFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    },
    "MaxExpandedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 68719476736
    },
    "TtlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800
    }
  }
}
