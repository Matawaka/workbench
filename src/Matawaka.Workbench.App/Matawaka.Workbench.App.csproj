<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BrandingIconBase64Path>$(MSBuildProjectDirectory)\Assets\Branding\MatawakaWorkbench.ico.b64</BrandingIconBase64Path>
    <BrandingGeneratedIconPath>$(BaseIntermediateOutputPath)branding\MatawakaWorkbench.ico</BrandingGeneratedIconPath>
    <ApplicationIcon>$(BrandingGeneratedIconPath)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Matawaka.Workbench.Protocol\Matawaka.Workbench.Protocol.csproj" />
    <ProjectReference Include="..\Matawaka.Workbench.Runtime\Matawaka.Workbench.Runtime.csproj" />
    <ProjectReference Include="..\Matawaka.Workbench.AgentHost\Matawaka.Workbench.AgentHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\.github\qualification\v056-provenance-admission\fixtures\uu-aap-955-qualification.json"
                      LogicalName="Matawaka.Workbench.App.ProvenanceReviewV0561.Qualification" />
    <EmbeddedResource Include="Assets\Branding\MatawakaWorkbench.ico.b64"
                      LogicalName="Matawaka.Workbench.App.Branding.IconV060Base64" />
    <EmbeddedResource Include="Assets\Branding\splash-v060.b64.001" LogicalName="Matawaka.Workbench.App.Branding.NeutralBase64.001" />
    <EmbeddedResource Include="Assets\Branding\splash-v060.b64.002" LogicalName="Matawaka.Workbench.App.Branding.NeutralBase64.002" />
    <EmbeddedResource Include="Assets\Branding\splash-v060.b64.003" LogicalName="Matawaka.Workbench.App.Branding.NeutralBase64.003" />
    <EmbeddedResource Include="Assets\Branding\splash-v060.b64.004" LogicalName="Matawaka.Workbench.App.Branding.NeutralBase64.004" />
  </ItemGroup>
  <Target Name="DecodeBrandingApplicationIcon" BeforeTargets="GenerateWin32Resources;CoreCompile">
    <Exec Command="powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$b64=[IO.File]::ReadAllText('$(BrandingIconBase64Path)').Trim(); [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName('$(BrandingGeneratedIconPath)')) | Out-Null; [IO.File]::WriteAllBytes('$(BrandingGeneratedIconPath)',[Convert]::FromBase64String($b64))&quot;" />
  </Target>
</Project>
