<Window x:Class="Matawaka.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matawaka Workbench v0.22.0" Height="820" Width="1380" MinHeight="680" MinWidth="940"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="PasteButton" Content="Вставить JSON" Width="120" Margin="0,0,8,0" Click="PasteButton_Click"/>
            <Button x:Name="FileButton" Content="Из файла" Width="100" Margin="0,0,8,0" Click="FileButton_Click"/>
            <Button x:Name="ValidateButton" Content="Проверить" Width="100" Margin="0,0,8,0" Click="ValidateButton_Click"/>
            <Button x:Name="RunButton" Content="Запустить" Width="100" Margin="0,0,8,0" Click="RunButton_Click"/>
            <Button x:Name="SelfTestButton" Content="Self-test" Width="90" Margin="0,0,8,0" Click="SelfTestButton_Click"/>
            <Button x:Name="AcceptCheckpointButton" Content="Принять" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="AcceptCheckpointButton_Click"/>
            <Button x:Name="UpdatePlanButton" Content="Пакет обновления" Width="130" Margin="0,0,8,0" Click="UpdatePlanButton_Click"/>
            <Button x:Name="MaterializeUpdateButton" Content="Материализовать" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="MaterializeUpdateButton_Click"/>
            <Button x:Name="StagedApplyPlanButton" Content="План применения" Width="125" Margin="0,0,8,0" IsEnabled="False" Click="StagedApplyPlanButton_Click"/>
            <Button x:Name="ApplyBuildUpdateButton" Content="Применить + собрать" Width="150" Margin="0,0,8,0" IsEnabled="False" Click="ApplyBuildUpdateButton_Click"/>
            <Button x:Name="LaunchCandidateButton" Content="Запустить candidate" Width="145" Margin="0,0,8,0" IsEnabled="False" Click="LaunchCandidateButton_Click"/>
            <Button x:Name="RecoveryCheckButton" Content="Recovery check" Width="120" Margin="0,0,8,0" Click="RecoveryCheckButton_Click"/>
            <Button x:Name="RecoveryPlanButton" Content="Recovery plan" Width="120" Margin="0,0,8,0" IsEnabled="False" Click="RecoveryPlanButton_Click"/>
            <Button x:Name="RecoveryExecuteButton" Content="Recovery execute" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="RecoveryExecuteButton_Click"/>
            <Button x:Name="RecoveryAdmissionButton" Content="Recovery admission" Width="135" Margin="0,0,8,0" Click="RecoveryAdmissionButton_Click"/>
            <Button x:Name="RecoveryNegativeControlsButton" Content="Recovery negatives" Width="135" Margin="0,0,8,0" Click="RecoveryNegativeControlsButton_Click"/>
            <Button x:Name="RecoveryEvidenceClosureButton" Content="Recovery closure" Width="135" Margin="0,0,8,0" Click="RecoveryEvidenceClosureButton_Click"/>
            <Button x:Name="CancelButton" Content="Стоп" Width="80" Margin="0,0,18,0" IsEnabled="False" Click="CancelButton_Click"/>
            <CheckBox x:Name="AgentEnabledBox" Content="Агент включен" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <CheckBox x:Name="AllowGitFetchBox" Content="Разрешить git fetch" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <TextBlock Text="v0.22: positive drill + admission + negative controls -> byte-bound recovery evidence closure; closure != broader authority" VerticalAlignment="Center" FontStyle="Italic"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Рабочее пространство:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="WorkspaceRootBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Сохранить" Width="100" Click="SaveWorkspaceButton_Click"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Каталог Matawaka:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="CatalogRootBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Сканировать" Width="110" Margin="0,0,8,0" Click="InspectCatalogButton_Click"/>
            <Button Grid.Column="3" Content="Обновить refs" Width="110" Click="FetchCatalogButton_Click"/>
        </Grid>

        <TextBox x:Name="JsonTextBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" TextWrapping="NoWrap"/>

        <Grid Grid.Row="4" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Прогресс" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" Text="IDLE" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <TabControl x:Name="OutputTabs" Grid.Row="5">
            <TabItem x:Name="EventsTab" Header="События">
                <ListBox x:Name="EventList" FontFamily="Consolas"/>
            </TabItem>
            <TabItem x:Name="ResultTab" Header="Результат">
                <TextBox x:Name="ResultTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="EvidenceTab" Header="Evidence Receipt">
                <TextBox x:Name="EvidenceTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="AuthorityTab" Header="Authority Receipt">
                <TextBox x:Name="AuthorityTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="LivenessTab" Header="Liveness">
                <TextBox x:Name="LivenessTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="SemanticTab" Header="Semantic Provider">
                <TextBox x:Name="SemanticTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="ProcessBoundaryTab" Header="Process Boundary">
                <TextBox x:Name="ProcessBoundaryTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="AcceptanceTab" Header="Acceptance">
                <TextBox x:Name="AcceptanceTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="UpdatePlanTab" Header="Update Plan">
                <TextBox x:Name="UpdatePlanTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="RecoveryTab" Header="Recovery">
                <TextBox x:Name="RecoveryTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem x:Name="AgentTab" Header="Agent">
                <TextBox x:Name="AgentTextBox" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
