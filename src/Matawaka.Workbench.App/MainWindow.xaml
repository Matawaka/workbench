<Window x:Class="Matawaka.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Matawaka.Workbench.App"
        Title="Matawaka Workbench v0.45" Height="760" Width="1280" MinHeight="620" MinWidth="940"
        Loaded="Window_LoadedV040"
        Closing="Window_Closing">
    <Window.Resources>
        <local:StatusForegroundV042Converter x:Key="StatusForegroundV042"/>
        <HierarchicalDataTemplate DataType="{x:Type local:AppTreeNodeV043}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Display}" ToolTip="{Binding RelativePath}"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- v0.45 machine-checks exactly four currently functional maintenance actions. -->
        <WrapPanel x:Name="PrimaryMaintenanceSurface" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="UpdateCandidateButton" Width="92" Height="46" Margin="0,0,6,0" Click="UpdateCandidateV040Button_Click"
                    ToolTip="One explicit confirmation may perform exact update/build → one-shot bootstrap → automatic exact launch/handoff. Successor first boot validates and locally accepts once if PASS. Publish remains separate.">
                <TextBlock TextAlignment="Center"><Run Text="Update"/><LineBreak/><Run Text="Workbench"/></TextBlock>
            </Button>
            <Button x:Name="UpdateLocalAppButton" Width="78" Height="46" Margin="0,0,6,0" Click="LocalAppsV0381Button_Click"
                    ToolTip="Manage registered local applications and build/apply bounded update packages.">
                <TextBlock TextAlignment="Center"><Run Text="Local"/><LineBreak/><Run Text="apps"/></TextBlock>
            </Button>
            <Button x:Name="PublishAcceptedButton" Width="88" Height="46" Margin="0,0,6,0" Click="PublishAcceptedV040Button_Click"
                    ToolTip="Publish only the exact locally accepted Workbench frontier to the fixed GitHub remote after explicit confirmation.">
                <TextBlock TextAlignment="Center"><Run Text="Publish"/><LineBreak/><Run Text="accepted"/></TextBlock>
            </Button>
            <Button x:Name="LifecycleReceiptButton" Width="88" Height="46" Click="LifecycleReceiptV2Button_Click"
                    ToolTip="Create a read-only lifecycle evidence assessment for the exact accepted/published frontier.">
                <TextBlock TextAlignment="Center"><Run Text="Lifecycle"/><LineBreak/><Run Text="receipt"/></TextBlock>
            </Button>
        </WrapPanel>

        <Border Grid.Row="1" Padding="7,5" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="InstalledAppsSummaryText" DockPanel.Dock="Left" Text="Apps" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="InstalledAppsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="7,3" Margin="0,0,6,0" Cursor="Hand"
                                        DataContext="{Binding}" Tag="{Binding ApplicationId}"
                                        Click="InstalledAppV044Button_Click"
                                        ToolTip="Open a closable read-only application tree; double-click a text file in the tree to inspect contents">
                                    <TextBlock Text="{Binding Display}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TabControl x:Name="OutputTabs" Grid.Row="2" Margin="0,0,0,8">
            <TabItem x:Name="EventsTab" Header="Events"><ListBox x:Name="EventList" FontFamily="Consolas"/></TabItem>
            <TabItem x:Name="UpdatePlanTab" Header="Update Workbench"><TextBox x:Name="UpdatePlanTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/></TabItem>
            <TabItem x:Name="LocalAppsTab" Header="Local Apps"><TextBox x:Name="LocalAppsTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/></TabItem>
            <TabItem x:Name="AcceptanceTab" Header="Acceptance / Publication"><TextBox x:Name="AcceptanceTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/></TabItem>
            <TabItem x:Name="LifecycleTab" Header="Lifecycle"><TextBox x:Name="LifecycleTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/></TabItem>
            <TabItem x:Name="ResultTab" Header="Result" Visibility="Collapsed"><TextBox x:Name="ResultTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="EvidenceTab" Header="Evidence" Visibility="Collapsed"><TextBox x:Name="EvidenceTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="AuthorityTab" Header="Authority" Visibility="Collapsed"><TextBox x:Name="AuthorityTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="LivenessTab" Header="Liveness" Visibility="Collapsed"><TextBox x:Name="LivenessTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="SemanticTab" Header="Semantic" Visibility="Collapsed"><TextBox x:Name="SemanticTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="ProcessBoundaryTab" Header="Process" Visibility="Collapsed"><TextBox x:Name="ProcessBoundaryTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="RecoveryTab" Header="Recovery" Visibility="Collapsed"><TextBox x:Name="RecoveryTextBox" IsReadOnly="True"/></TabItem>
            <TabItem x:Name="AgentTab" Header="Agent" Visibility="Collapsed"><TextBox x:Name="AgentTextBox" IsReadOnly="True"/></TabItem>
        </TabControl>

        <Grid x:Name="JsonSearchSurface" Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Find in output:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="JsonSearchBox" Grid.Column="1" VerticalContentAlignment="Center" KeyDown="JsonSearchBox_KeyDown"
                     ToolTip="Searches the currently selected text output, including read-only app text tabs. Ctrl+F focuses here; Enter/F3 finds next; Shift+Enter/Shift+F3 finds previous."/>
            <Button x:Name="JsonSearchPreviousButton" Grid.Column="2" Content="Previous" Margin="8,0,0,0" Padding="10,2" Click="JsonSearchPreviousButton_Click"/>
            <Button x:Name="JsonSearchNextButton" Grid.Column="3" Content="Next" Margin="6,0,0,0" Padding="10,2" Click="JsonSearchNextButton_Click"/>
            <Button x:Name="JsonSearchClearButton" Grid.Column="4" Content="Clear" Margin="6,0,0,0" Padding="10,2" Click="JsonSearchClearButton_Click"/>
            <TextBlock x:Name="JsonSearchStatusText" Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="StatusProgressSurface" Grid.Row="4" Height="26">
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Opacity="0.26"/>
            <TextBlock x:Name="StatusText" Text="IDLE" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusForegroundV042}}"/>
        </Grid>

        <!-- Historical bindings remain only so old partial classes compile; v0.45 runtime quarantine keeps them inert. -->
        <StackPanel x:Name="HistoricalCompatibilityBindings" Grid.Row="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
            <TextBox x:Name="WorkspaceRootBox" Focusable="False" IsTabStop="False"/>
            <TextBox x:Name="CatalogRootBox" Focusable="False" IsTabStop="False"/>
            <Button x:Name="SelfTestButton" Content="Self-test" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False" Click="SelfTestV040Button_Click"/>
            <Button x:Name="AcceptCheckpointButton" Content="Accept" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False" Click="AcceptCheckpointV040Button_Click"/>
            <Button x:Name="CancelButton" Content="Stop" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False" Click="CancelButton_Click"/>
            <Button x:Name="LaunchCandidateButton" Content="Launch candidate" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False" Click="LaunchCandidateV039Button_Click"/>
            <Button x:Name="PasteButton"/><Button x:Name="FileButton"/><Button x:Name="ValidateButton"/><Button x:Name="RunButton"/>
            <Button x:Name="UpdatePlanButton"/><Button x:Name="MaterializeUpdateButton"/><Button x:Name="StagedApplyPlanButton"/><Button x:Name="ApplyBuildUpdateButton"/>
            <Button x:Name="RecoveryCheckButton"/><Button x:Name="RecoveryPlanButton"/><Button x:Name="RecoveryExecuteButton"/>
            <Button x:Name="RecoveryAdmissionButton"/><Button x:Name="RecoveryNegativeControlsButton"/><Button x:Name="RecoveryEvidenceClosureButton"/>
            <Button x:Name="RecoveryEvidenceReplayButton"/><Button x:Name="RecoveryEvidenceRelocationButton"/><Button x:Name="RecoveryEvidenceExportButton"/><Button x:Name="RecoveryEvidenceImportButton"/>
            <Button x:Name="RecoveryTransportIndependenceButton"/><Button x:Name="RecoveryTransportAdversarialControlsButton"/><Button x:Name="RecoveryTransportAdversarialEvidenceClosureButton"/>
            <Button x:Name="ProducerKeyProvenanceBoundaryButton"/><Button x:Name="ProducerKeyRotationContinuityBoundaryButton"/><Button x:Name="ProducerKeyRevocationInferenceBoundaryButton"/>
            <CheckBox x:Name="AgentEnabledBox" IsChecked="False" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
            <CheckBox x:Name="AllowGitFetchBox" IsChecked="False" IsEnabled="False" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
            <TextBox x:Name="JsonTextBox" Focusable="False" IsTabStop="False"/>
        </StackPanel>
    </Grid>
</Window>
