<Window x:Class="Matawaka.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matawaka Workbench v0.36.0" Height="760" Width="1280" MinHeight="620" MinWidth="940"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- v0.36: still exactly eight active buttons, zero persistent authority checkboxes. -->
        <WrapPanel x:Name="PrimaryMaintenanceSurface" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="UpdateCandidateButton" Content="Update Workbench" Width="130" Margin="0,0,8,0"
                    Click="UpdateCandidateButton_Click"
                    ToolTip="Bounded package → materialize → apply-plan → apply/build; Launch remains separate"/>
            <Button x:Name="LaunchCandidateButton" Content="Launch candidate" Width="130" Margin="0,0,8,0" IsEnabled="False"
                    Click="LaunchCandidateButton_Click"
                    ToolTip="Launch exact receipt-bound Workbench candidate; acceptance remains separate"/>
            <Button x:Name="UpdateLocalAppButton" Content="Local apps" Width="110" Margin="0,0,8,0"
                    Click="LocalAppsButton_Click"
                    ToolTip="Select one direct child of Workspace\Apps: unregistered → Register; registered → choose bounded local update ZIP"/>
            <Button x:Name="SelfTestButton" Content="Self-test" Width="90" Margin="0,0,8,0"
                    Click="SelfTestV036Button_Click"
                    ToolTip="Read-only accepted matrix + offline registration contract checks; no real app registration/update"/>
            <Button x:Name="AcceptCheckpointButton" Content="Accept" Width="85" Margin="0,0,8,0" IsEnabled="False"
                    Click="AcceptCheckpointV036Button_Click"/>
            <Button x:Name="PublishAcceptedButton" Content="Publish accepted" Width="130" Margin="0,0,8,0"
                    Click="PublishAcceptedV036Button_Click"
                    ToolTip="Fixed Matawaka/workbench, exact fast-forward/tag only, no force"/>
            <Button x:Name="LifecycleReceiptButton" Content="Lifecycle receipt" Width="125" Margin="0,0,8,0"
                    Click="LifecycleReceiptV2Button_Click"
                    ToolTip="Lifecycle v2 evidence composition; summary != authority"/>
            <Button x:Name="CancelButton" Content="Stop" Width="75" IsEnabled="False" Click="CancelButton_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Workspace:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="WorkspaceRootBox" Grid.Column="1" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Matawaka catalog:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="CatalogRootBox" Grid.Column="1" VerticalContentAlignment="Center"/>
        </Grid>

        <Border Grid.Row="3" Padding="8" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Managed local apps: Workspace\Apps\&lt;ApplicationId&gt;" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Local apps: existing folder → identity-only Register; registered app → bounded update. Register != Import != Update != Launch."
                           TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Progress" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="20" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="IDLE" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <TabControl x:Name="OutputTabs" Grid.Row="1">
                <TabItem x:Name="EventsTab" Header="Events">
                    <ListBox x:Name="EventList" FontFamily="Consolas"/>
                </TabItem>
                <TabItem x:Name="UpdatePlanTab" Header="Update Workbench">
                    <TextBox x:Name="UpdatePlanTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextWrapping="NoWrap"/>
                </TabItem>
                <TabItem x:Name="LocalAppsTab" Header="Local Apps">
                    <TextBox x:Name="LocalAppsTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextWrapping="NoWrap"/>
                </TabItem>
                <TabItem x:Name="AcceptanceTab" Header="Acceptance / Publication">
                    <TextBox x:Name="AcceptanceTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextWrapping="NoWrap"/>
                </TabItem>
                <TabItem x:Name="LifecycleTab" Header="Lifecycle">
                    <TextBox x:Name="LifecycleTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextWrapping="NoWrap"/>
                </TabItem>

                <TabItem x:Name="ResultTab" Header="Result" Visibility="Collapsed"><TextBox x:Name="ResultTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="EvidenceTab" Header="Evidence" Visibility="Collapsed"><TextBox x:Name="EvidenceTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="AuthorityTab" Header="Authority" Visibility="Collapsed"><TextBox x:Name="AuthorityTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="LivenessTab" Header="Liveness" Visibility="Collapsed"><TextBox x:Name="LivenessTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="SemanticTab" Header="Semantic" Visibility="Collapsed"><TextBox x:Name="SemanticTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="ProcessBoundaryTab" Header="Process" Visibility="Collapsed"><TextBox x:Name="ProcessBoundaryTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="RecoveryTab" Header="Recovery" Visibility="Collapsed"><TextBox x:Name="RecoveryTextBox" IsReadOnly="True"/></TabItem>
                <TabItem x:Name="AgentTab" Header="Agent" Visibility="Collapsed"><TextBox x:Name="AgentTextBox" IsReadOnly="True"/></TabItem>
            </TabControl>
        </Grid>

        <StackPanel x:Name="HistoricalCompatibilityBindings" Grid.Row="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
            <Button x:Name="PasteButton"/><Button x:Name="FileButton"/><Button x:Name="ValidateButton"/><Button x:Name="RunButton"/>
            <Button x:Name="UpdatePlanButton"/><Button x:Name="MaterializeUpdateButton"/><Button x:Name="StagedApplyPlanButton"/><Button x:Name="ApplyBuildUpdateButton"/>
            <Button x:Name="RecoveryCheckButton"/><Button x:Name="RecoveryPlanButton"/><Button x:Name="RecoveryExecuteButton"/>
            <Button x:Name="RecoveryAdmissionButton"/><Button x:Name="RecoveryNegativeControlsButton"/><Button x:Name="RecoveryEvidenceClosureButton"/>
            <Button x:Name="RecoveryEvidenceReplayButton"/><Button x:Name="RecoveryEvidenceRelocationButton"/><Button x:Name="RecoveryEvidenceExportButton"/><Button x:Name="RecoveryEvidenceImportButton"/>
            <Button x:Name="RecoveryTransportIndependenceButton"/><Button x:Name="RecoveryTransportAdversarialControlsButton"/><Button x:Name="RecoveryTransportAdversarialEvidenceClosureButton"/>
            <Button x:Name="ProducerKeyProvenanceBoundaryButton"/><Button x:Name="ProducerKeyRotationContinuityBoundaryButton"/><Button x:Name="ProducerKeyRevocationInferenceBoundaryButton"/>
            <CheckBox x:Name="AgentEnabledBox" IsChecked="False"/><CheckBox x:Name="AllowGitFetchBox" IsChecked="False"/>
            <TextBox x:Name="JsonTextBox"/>
        </StackPanel>
    </Grid>
</Window>
